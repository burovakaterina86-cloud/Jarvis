.env
.env.*
!.env.example
node_modules/
__pycache__/
.DS_Store
.autopilot/serve.*

# ESSA-JARVIS
state/
inbox/
.venv/
.pytest_cache/

.playwright-mcp/

# готовые медиа (видео, картинки, музыка) — не в git
outbox/*
!outbox/.gitkeep

# кэш и исключения хука дизайн-проверки (impeccable): локальные, не для репозитория
.impeccable/

# сырые выгрузки Apify агента «Контент-план» (десятки МБ, чужие данные; пересобираются)
essa-ai/content-plan/weeks/*/raw/
essa-ai/content-plan/examples/raw/
essa-ai/content-plan/weeks/*/_phone.html

# очередь фоновых работ бота (запросы агента)
/jobs/
